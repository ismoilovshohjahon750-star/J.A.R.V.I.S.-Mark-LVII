rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'assistantName', 'userName',
        'accentColor', 'hudStyle', 'voiceName', 'morningBrief',
        'pushToTalk', 'wakeWord', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'assistantName', 'userName',
        'accentColor', 'hudStyle', 'voiceName', 'morningBrief',
        'pushToTalk', 'wakeWord', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
      && data.displayName is string && data.displayName.size() <= 120
      && data.assistantName is string && data.assistantName.size() >= 1 && data.assistantName.size() <= 60
      && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
      && data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
      && data.hudStyle is string && data.hudStyle in ['face', 'reactor']
      && data.voiceName is string && data.voiceName.size() >= 1 && data.voiceName.size() <= 40
      && data.morningBrief is bool
      && data.pushToTalk is bool
      && data.wakeWord is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['uid', 'role', 'text', 'source', 'createdAt'])
      && data.keys().hasOnly(['uid', 'role', 'text', 'source', 'createdAt'])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.role is string && data.role in ['user', 'assistant', 'system']
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 12000
      && data.source is string && data.source.size() <= 64
      && data.createdAt is timestamp;
    }

    function isValidMemoryItem(data) {
      return data.keys().hasAll(['uid', 'category', 'key', 'content', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'category', 'key', 'content', 'createdAt', 'updatedAt'])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.category is string && data.category in ['identity', 'preference', 'project', 'session', 'fact']
      && data.key is string && data.key.size() >= 1 && data.key.size() <= 120
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidBackgroundTask(data) {
      return data.keys().hasAll([
        'uid', 'title', 'prompt', 'agent', 'status',
        'result', 'steps', 'budgetMinutes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'title', 'prompt', 'agent', 'status',
        'result', 'steps', 'budgetMinutes', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
      && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000
      && data.agent is string && data.agent in ['general', 'researcher']
      && data.status is string && data.status in ['queued', 'running', 'done', 'failed', 'cancelled']
      && data.result is string && data.result.size() <= 16000
      && data.steps is list && data.steps.size() <= 20
      && (data.steps.size() == 0 || (data.steps[0] is string && data.steps[0].size() <= 300))
      && (data.budgetMinutes is int || data.budgetMinutes is float)
      && data.budgetMinutes >= 1 && data.budgetMinutes <= 60
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRoutineItem(data) {
      return data.keys().hasAll([
        'uid', 'name', 'kind', 'triggerType', 'scheduleText',
        'text', 'enabled', 'quiet', 'runs', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'name', 'kind', 'triggerType', 'scheduleText',
        'text', 'enabled', 'quiet', 'runs', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
      && data.kind is string && data.kind in ['say', 'prompt', 'task', 'builtin']
      && data.triggerType is string && data.triggerType in ['time', 'startup', 'idle']
      && data.scheduleText is string && data.scheduleText.size() >= 1 && data.scheduleText.size() <= 120
      && data.text is string && data.text.size() <= 1000
      && data.enabled is bool
      && data.quiet is bool
      && data.runs is int && data.runs >= 0 && data.runs <= 1000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMonitorItem(data) {
      return data.keys().hasAll([
        'uid', 'topic', 'frequency', 'lastSummary', 'enabled', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'topic', 'frequency', 'lastSummary', 'enabled', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200
      && data.frequency is string && data.frequency in ['daily', 'hourly', 'weekly']
      && data.lastSummary is string && data.lastSummary.size() <= 4000
      && data.enabled is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // User Profile & Preferences (PII isolated strictly to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'assistantName', 'userName', 'accentColor',
          'hudStyle', 'voiceName', 'morningBrief', 'pushToTalk',
          'wakeWord', 'updatedAt'
        ]);
      allow delete: if false;

      // Communications Log Messages
      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(messageId)
          && isVerified()
          && isOwner(userId)
          && isValidChatMessage(incoming())
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isVerified() && isOwner(userId);
      }

      // Persistent Long-Term Memory
      match /memories/{memoryId} {
        allow get: if isValidId(userId) && isValidId(memoryId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(memoryId)
          && isVerified()
          && isOwner(userId)
          && isValidMemoryItem(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerified()
          && isValidId(userId) && isValidId(memoryId)
          && isOwner(userId)
          && isValidMemoryItem(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'key', 'content', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(memoryId) && isVerified() && isOwner(userId);
      }

      // Background Autonomous Tasks
      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(taskId)
          && isVerified()
          && isOwner(userId)
          && isValidBackgroundTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerified()
          && isValidId(userId) && isValidId(taskId)
          && isOwner(userId)
          && isValidBackgroundTask(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && !(existing().status in ['done', 'failed', 'cancelled'])
          && (
            (incoming().status in ['running', 'queued'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'steps', 'updatedAt']))
            || (incoming().status in ['done', 'failed', 'cancelled'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'result', 'steps', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && isVerified() && isOwner(userId);
      }

      // Automated Routines
      match /routines/{routineId} {
        allow get: if isValidId(userId) && isValidId(routineId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(routineId)
          && isVerified()
          && isOwner(userId)
          && isValidRoutineItem(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerified()
          && isValidId(userId) && isValidId(routineId)
          && isOwner(userId)
          && isValidRoutineItem(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['runs', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'scheduleText', 'text', 'enabled', 'quiet', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(routineId) && isVerified() && isOwner(userId);
      }

      // Background Topic Monitors
      match /monitors/{monitorId} {
        allow get: if isValidId(userId) && isValidId(monitorId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(monitorId)
          && isVerified()
          && isOwner(userId)
          && isValidMonitorItem(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerified()
          && isValidId(userId) && isValidId(monitorId)
          && isOwner(userId)
          && isValidMonitorItem(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['lastSummary', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'frequency', 'enabled', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(monitorId) && isVerified() && isOwner(userId);
      }
    }
  }
}
